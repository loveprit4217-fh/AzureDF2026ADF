{
	"name": "CopyMfData",
	"properties": {
		"activities": [
			{
				"name": "CopyMfData",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "RestSource",
						"httpRequestTimeout": "00:01:40",
						"requestInterval": "00.00:00:00.010",
						"requestMethod": "GET",
						"paginationRules": {
							"supportRFC5988": "true"
						}
					},
					"sink": {
						"type": "JsonSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings",
							"copyBehavior": "PreserveHierarchy"
						},
						"formatSettings": {
							"type": "JsonWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"path": "$['payload']['codeViewBlobRoute']['csv'][0][0]"
								},
								"sink": {
									"path": "$['payload']['codeViewBlobRoute']['csv'][0][0]"
								}
							}
						],
						"collectionReference": ""
					}
				},
				"inputs": [
					{
						"referenceName": "dataset_rest_mf",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "api_dataset_mf",
						"type": "DatasetReference"
					}
				]
			}
		],
		"annotations": []
	}
}